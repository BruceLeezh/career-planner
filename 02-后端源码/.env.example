# 复制本文件为 .env 后填写真实值；.env 已被 .gitignore 排除，不会进入仓库。
# cp .env.example .env && 编辑 .env

PORT=3000

# JWT 签名密钥：请使用 32 位以上随机字符串，勿复用示例值
JWT_SECRET=replace-with-a-long-random-string

# AI 服务（OpenAI 兼容接口）
AI_BASE_URL=https://your-ai-endpoint.example.com/v1
AI_API_KEY=replace-with-your-api-key
AI_MODEL=your-model-name

# 可选：MySQL（默认使用本地 SQLite）
# DB_DIALECT=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=your-db-user
# DB_PASSWORD=your-db-password
# DB_NAME=career_planner

# 可选：SMTP 邮件
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your-smtp-password
